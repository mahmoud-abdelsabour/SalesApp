@model WebApplication2.Models.ViewModels.ReportsViewModel
@{
    var ar = WebApplication2.Helpers.LanguageHelper.IsArabic();
    Func<string, string, string> L = (en, arText) => ar ? arText : en;

    ViewBag.Title = L("Reports", "التقارير");
    var from = Model.From.ToString("yyyy-MM-dd");
    var to = Model.To.ToString("yyyy-MM-dd");
    var none = "—";

    var labels = Model.DateChart.Select(p => p.Label).ToList();
    var values = Model.DateChart.Select(p => p.Value).ToList();
}

<style>
    .page-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; margin-bottom: 16px; }
    .page-head h4 { margin: 0; font-weight: 700; color: var(--primary); }
    .page-head p { margin: 2px 0 0; color: var(--text-muted); font-size: 0.88rem; }

    .kpi { display: flex; align-items: center; gap: 14px; }
    .kpi-icon { width: 46px; height: 46px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.15rem; flex-shrink: 0; }
    .kpi-label { font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: .4px; }
    .kpi-value { font-size: 1.45rem; font-weight: 700; line-height: 1.2; }
    .kpi-hero { background: linear-gradient(135deg, #0D1B2A 0%, #1B6CA8 100%); color: #fff; }
    .kpi-hero .kpi-label { color: rgba(255,255,255,.7); }
    .kpi-hero .kpi-icon { background: rgba(255,255,255,.16); color: #fff; }

    .section-title { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .6px; color: var(--text-muted); margin: 6px 0 10px; }

    .report-card { display: block; height: 100%; color: inherit; text-decoration: none !important; border-top: 4px solid var(--accent-color); transition: transform .2s, box-shadow .2s; }
    .report-card:hover { transform: translateY(-4px); box-shadow: 0 10px 28px rgba(0,0,0,.12); color: inherit; }
    .report-card .rc-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; background: var(--accent-bg); color: var(--accent-color); font-size: 1.1rem; }
    .report-card h6 { font-weight: 700; margin: 12px 0 2px; }
    .report-card .rc-desc { font-size: 0.82rem; color: var(--text-muted); min-height: 36px; }
    .report-card .rc-stat { margin-top: 12px; padding: 10px 12px; border-radius: 10px; background: #F7F9FC; }
    .report-card .rc-stat small { display: block; color: var(--text-muted); font-size: 0.72rem; text-transform: uppercase; letter-spacing: .4px; }
    .report-card .rc-stat strong { display: block; font-size: 0.95rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .report-card .rc-stat span { font-size: 0.82rem; color: var(--text-muted); }
    .report-card .rc-open { margin-top: 14px; font-size: 0.85rem; font-weight: 600; color: var(--accent-color); }
</style>

<div class="page-head">
    <div>
        <h4><i class="fas fa-chart-bar mr-2"></i>@L("Sales Reports", "تقارير المبيعات")</h4>
        <p>@L("Performance overview for the selected period.", "نظرة عامة على الأداء خلال الفترة المحددة.")</p>
    </div>
</div>

<!-- Period -->
<div class="card mb-4">
    <div class="card-body py-3">
        @Html.Partial("_RangeFilter", new WebApplication2.Models.ViewModels.ReportRangeModel { Action = "Index", From = Model.From, To = Model.To })
    </div>
</div>

<!-- KPIs -->
<div class="row mb-2">
    <div class="col-12 col-md-6 col-xl-3 mb-3">
        <div class="card kpi-hero h-100"><div class="card-body kpi">
            <div class="kpi-icon"><i class="fas fa-coins"></i></div>
            <div>
                <div class="kpi-label">@L("Total Sales", "إجمالي المبيعات")</div>
                <div class="kpi-value">@Model.TotalRevenue.ToString("N2")</div>
            </div>
        </div></div>
    </div>
    <div class="col-12 col-md-6 col-xl-3 mb-3">
        <div class="card h-100"><div class="card-body kpi">
            <div class="kpi-icon" style="background:#E8F1FA;color:#1B6CA8"><i class="fas fa-file-invoice"></i></div>
            <div>
                <div class="kpi-label">@L("Invoices", "الفواتير")</div>
                <div class="kpi-value">@Model.InvoiceCount</div>
            </div>
        </div></div>
    </div>
    <div class="col-12 col-md-6 col-xl-3 mb-3">
        <div class="card h-100"><div class="card-body kpi">
            <div class="kpi-icon" style="background:#E6F5EE;color:#2D9B6F"><i class="fas fa-receipt"></i></div>
            <div>
                <div class="kpi-label">@L("Average Invoice", "متوسط الفاتورة")</div>
                <div class="kpi-value">@Model.AverageInvoice.ToString("N2")</div>
            </div>
        </div></div>
    </div>
    <div class="col-12 col-md-6 col-xl-3 mb-3">
        <div class="card h-100"><div class="card-body kpi">
            <div class="kpi-icon" style="background:#FDF0E4;color:#F4A261"><i class="fas fa-cubes"></i></div>
            <div>
                <div class="kpi-label">@L("Items Sold", "الوحدات المباعة")</div>
                <div class="kpi-value">@Model.ItemsSold</div>
            </div>
        </div></div>
    </div>
</div>

<!-- Trend -->
<div class="card mb-4">
    <div class="card-header"><i class="fas fa-chart-line mr-2"></i>@L("Sales trend", "اتجاه المبيعات")</div>
    <div class="card-body">
        <div style="height:260px"><canvas id="trendChart"></canvas></div>
    </div>
</div>

<!-- Reports -->
<div class="section-title">@L("Explore reports", "استعرض التقارير")</div>
<div class="row">
    <div class="col-md-4 mb-3">
        <a class="card report-card" style="--accent-color:#1B6CA8;--accent-bg:#E8F1FA" href="@Url.Action("ByDate", new { from = from, to = to })">
            <div class="card-body">
                <div class="rc-icon"><i class="fas fa-calendar-day"></i></div>
                <h6>@L("Sales by Date", "المبيعات حسب التاريخ")</h6>
                <div class="rc-desc">@L("Daily totals, invoice counts and averages.", "الإجماليات اليومية وعدد الفواتير والمتوسط.")</div>
                <div class="rc-stat">
                    <small>@L("Best day", "أفضل يوم")</small>
                    <strong>@(Model.BestDay ?? none)</strong>
                    @if (Model.BestDay != null) { <span>@Model.BestDayTotal.ToString("N2")</span> }
                </div>
                <div class="rc-open">@L("Open report", "فتح التقرير") <i class="fas fa-arrow-@(ar ? "left" : "right") ml-1"></i></div>
            </div>
        </a>
    </div>
    <div class="col-md-4 mb-3">
        <a class="card report-card" style="--accent-color:#2D9B6F;--accent-bg:#E6F5EE" href="@Url.Action("ByCustomer", new { from = from, to = to })">
            <div class="card-body">
                <div class="rc-icon"><i class="fas fa-users"></i></div>
                <h6>@L("Sales by Customer", "المبيعات حسب العميل")</h6>
                <div class="rc-desc">@L("Who buys the most, with each customer's share.", "من يشتري أكثر، مع نسبة كل عميل.")</div>
                <div class="rc-stat">
                    <small>@L("Top customer", "أفضل عميل")</small>
                    <strong>@(Model.TopCustomer ?? none)</strong>
                    @if (Model.TopCustomer != null) { <span>@Model.TopCustomerTotal.ToString("N2")</span> }
                </div>
                <div class="rc-open">@L("Open report", "فتح التقرير") <i class="fas fa-arrow-@(ar ? "left" : "right") ml-1"></i></div>
            </div>
        </a>
    </div>
    <div class="col-md-4 mb-3">
        <a class="card report-card" style="--accent-color:#E08A3C;--accent-bg:#FDF0E4" href="@Url.Action("ByProduct", new { from = from, to = to })">
            <div class="card-body">
                <div class="rc-icon"><i class="fas fa-box"></i></div>
                <h6>@L("Sales by Product", "المبيعات حسب المنتج")</h6>
                <div class="rc-desc">@L("Quantity sold and revenue per product.", "الكمية المباعة والإيراد لكل منتج.")</div>
                <div class="rc-stat">
                    <small>@L("Top product", "أفضل منتج")</small>
                    <strong>@(Model.TopProduct ?? none)</strong>
                    @if (Model.TopProduct != null) { <span>@Model.TopProductRevenue.ToString("N2")</span> }
                </div>
                <div class="rc-open">@L("Open report", "فتح التقرير") <i class="fas fa-arrow-@(ar ? "left" : "right") ml-1"></i></div>
            </div>
        </a>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <script>
        var labels = @Html.Raw(Json.Encode(labels));
        var values = @Html.Raw(Json.Encode(values));

        if (labels.length === 0) {
            $('#trendChart').parent().html('<p class="text-center text-muted pt-5">@L("No sales in this period", "لا توجد مبيعات في هذه الفترة")</p>');
        } else {
            // a line needs several points; with only a few days a bar chart reads better
            var asBars = labels.length < 4;
            new Chart(document.getElementById('trendChart'), {
                type: asBars ? 'bar' : 'line',
                data: { labels: labels, datasets: [{ label: '@L("Sales", "المبيعات")', data: values, borderColor: '#1B6CA8',
                    backgroundColor: asBars ? '#1B6CA8' : 'rgba(27,108,168,0.12)', fill: true, tension: 0.3, pointRadius: 3,
                    maxBarThickness: 60 }] },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true } } }
            });
        }
    </script>
}
