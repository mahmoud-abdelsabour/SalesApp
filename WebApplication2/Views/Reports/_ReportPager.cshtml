@model WebApplication2.Models.ViewModels.ReportPagerModel
@{
    var table = Model.Table;
    var ar = WebApplication2.Helpers.LanguageHelper.IsArabic();

    Func<int, string> link = p =>
    {
        var route = Model.Route != null
            ? new System.Web.Routing.RouteValueDictionary(Model.Route)
            : new System.Web.Routing.RouteValueDictionary
            {
                { "from", Model.From.ToString("yyyy-MM-dd") },
                { "to", Model.To.ToString("yyyy-MM-dd") }
            };
        route["page"] = p;
        return Url.Action(Model.Action, "Reports", route);
    };

    int first = (table.Page - 1) * table.PageSize + 1;
    int last = Math.Min(table.Page * table.PageSize, table.TotalRecords);
    int start = Math.Max(1, table.Page - 2);
    int end = Math.Min(table.TotalPages, table.Page + 2);
}
@if (table.TotalPages > 1)
{
    <div class="d-flex flex-wrap justify-content-between align-items-center mt-3">
        <small class="text-muted">@first–@last @(ar ? "من" : "of") @table.TotalRecords</small>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(table.Page == 1 ? "disabled" : "")">
                <a class="page-link" href="@link(Math.Max(1, table.Page - 1))">&laquo;</a>
            </li>
            @if (start > 1)
            {
                <li class="page-item"><a class="page-link" href="@link(1)">1</a></li>
                if (start > 2) { <li class="page-item disabled"><span class="page-link">…</span></li> }
            }
            @for (int p = start; p <= end; p++)
            {
                <li class="page-item @(p == table.Page ? "active" : "")">
                    <a class="page-link" href="@link(p)">@p</a>
                </li>
            }
            @if (end < table.TotalPages)
            {
                if (end < table.TotalPages - 1) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                <li class="page-item"><a class="page-link" href="@link(table.TotalPages)">@table.TotalPages</a></li>
            }
            <li class="page-item @(table.Page == table.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@link(Math.Min(table.TotalPages, table.Page + 1))">&raquo;</a>
            </li>
        </ul>
    </div>
}
