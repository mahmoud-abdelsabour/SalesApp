@model WebApplication2.Models.ViewModels.TableReport
@{
    var noData = WebApplication2.Helpers.LanguageHelper.IsArabic() ? "لا توجد بيانات في هذه الفترة" : "No data in this period";
}
<div class="table-responsive">
    <table class="table table-hover table-sm mb-0">
        <thead class="thead-light">
            <tr>
                @foreach (var col in Model.Columns)
                {
                    <th>@col.Header</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="@Model.Columns.Count" class="text-center text-muted py-4">@noData</td></tr>
            }
            @foreach (var row in Model.Rows)
            {
                <tr>
                    @for (int c = 0; c < Model.Columns.Count; c++)
                    {
                        var value = row[c];
                        string text;
                        string cls = "";
                        if (value is DateTime) { text = ((DateTime)value).ToString("yyyy-MM-dd"); }
                        else if (value is decimal && Model.Columns[c].Signed)
                        {
                            // change / growth: show + or - and color it
                            var d = (decimal)value;
                            text = (d > 0 ? "+" : "") + d.ToString("N2");
                            cls = d > 0 ? "text-success" : (d < 0 ? "text-danger" : "text-muted");
                        }
                        else if (value is decimal) { text = ((decimal)value).ToString("N2"); }
                        else { text = value == null ? "" : value.ToString(); }
                        if (Model.Columns[c].Signed)
                        {
                            // keep the + / - sign in front of the number in right-to-left pages
                            <td class="@cls"><span dir="ltr">@text</span></td>
                        }
                        else
                        {
                            <td class="@cls">@text</td>
                        }
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
