@model WebApplication2.Models.ViewModels.TableReport
@{
    Layout = null;
    var isArabic = WebApplication2.Helpers.LanguageHelper.IsArabic();
    var dir = isArabic ? "rtl" : "ltr";
    var lang = isArabic ? "ar" : "en";
    var saveLabel = isArabic ? "طباعة / حفظ PDF" : "Print / Save as PDF";
    var backLabel = isArabic ? "رجوع" : "Back";
    var hint = isArabic ? "في نافذة الطباعة اختر «حفظ كـ PDF»." : "In the print dialog choose \"Save as PDF\".";
    var totalLabel = isArabic ? "الإجمالي: " : "Total records: ";
    var printedLabel = isArabic ? "تاريخ الطباعة: " : "Printed: ";
}
<!DOCTYPE html>
<html lang="@lang" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Title - @WebApplication2.Resources.Labels.AppName</title>
    <style>
        @@page { size: A4 landscape; margin: 12mm; }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            background: #f3f4f6;
            color: #1A202C;
            font-family: 'Segoe UI', Tahoma, 'Noto Naskh Arabic', Arial, sans-serif;
            font-size: 13px;
            line-height: 1.45;
        }

        .toolbar { max-width: 1100px; margin: 16px auto 0; display: flex; justify-content: space-between; padding: 0 16px; }
        .toolbar a, .toolbar button { padding: 8px 16px; border-radius: 8px; border: none; font-size: 14px; cursor: pointer; text-decoration: none; }
        .btn-back { background: #e5e7eb; color: #374151; }
        .btn-print { background: #1B6CA8; color: #fff; }
        .hint { max-width: 1100px; margin: 6px auto 0; padding: 0 16px; color: #6b7280; font-size: 12px; }

        .sheet { max-width: 1100px; margin: 16px auto; background: #fff; padding: 28px 32px; box-shadow: 0 4px 24px rgba(0,0,0,.08); }

        .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 3px solid #1B6CA8; padding-bottom: 14px; margin-bottom: 16px; }
        .brand { display: flex; align-items: center; gap: 12px; }
        .brand img { width: 52px; height: 52px; }
        .brand h1 { margin: 0; font-size: 20px; color: #0D1B2A; }
        .meta { text-align: end; }
        .meta h2 { margin: 0 0 2px; font-size: 18px; }
        .meta p { margin: 0; color: #6b7280; font-size: 12px; }

        table { width: 100%; border-collapse: collapse; }
        th { background: #0D1B2A; color: #fff; padding: 7px 9px; font-size: 12px; text-align: start; }
        td { padding: 6px 9px; border-bottom: 1px solid #e5e7eb; vertical-align: top; }
        tbody tr:nth-child(even) td { background: #f9fafb; }
        thead { display: table-header-group; }
        tr { page-break-inside: avoid; }
        .num { text-align: end; white-space: nowrap; }

        .footer { margin-top: 14px; display: flex; justify-content: space-between; color: #6b7280; font-size: 12px; }

        @@media print {
            body { background: #fff; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .toolbar, .hint { display: none !important; }
            .sheet { box-shadow: none; margin: 0; padding: 0; max-width: none; }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <a href="javascript:history.back()" class="btn-back">@backLabel</a>
        <button type="button" class="btn-print" onclick="window.print()">@saveLabel</button>
    </div>
    <div class="hint">@hint</div>

    <div class="sheet">
        <div class="header">
            <div class="brand">
                <img src="@Url.Content("~/Content/logo.svg")" alt="Logo" />
                <h1>@WebApplication2.Resources.Labels.AppName</h1>
            </div>
            <div class="meta">
                <h2>@Model.Title</h2>
                @if (!string.IsNullOrEmpty(Model.Subtitle))
                {
                    <p>@Model.Subtitle</p>
                }
                <p>@printedLabel@DateTime.Now.ToString("yyyy-MM-dd HH:mm")</p>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>#</th>
                    @foreach (var col in Model.Columns)
                    {
                        <th>@col.Header</th>
                    }
                </tr>
            </thead>
            <tbody>
                @{int n = 1;}
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>@n</td>
                        @for (int c = 0; c < Model.Columns.Count; c++)
                        {
                            var value = row[c];
                            string text;
                            bool numeric = false;
                            if (value == null) { text = ""; }
                            else if (value is DateTime)
                            {
                                var dt = (DateTime)value;
                                text = Model.Columns[c].Format == WebApplication2.Helpers.ExcelExportHelper.DateFormat
                                    ? dt.ToString("yyyy-MM-dd") : dt.ToString("yyyy-MM-dd HH:mm");
                            }
                            else if (value is decimal) { text = ((decimal)value).ToString("N2"); numeric = true; }
                            else if (value is int) { text = value.ToString(); numeric = true; }
                            else { text = value.ToString(); }
                            <td class="@(numeric ? "num" : "")">@text</td>
                        }
                    </tr>
                    n++;
                }
            </tbody>
        </table>

        <div class="footer">
            <span>@totalLabel@Model.Rows.Count</span>
            <span>@WebApplication2.Resources.Labels.AppName</span>
        </div>
    </div>
</body>
</html>
